# Supabase Configuration
# Find these in your Supabase Dashboard: Settings -> API (or Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Supabase Server-Only Secret (NEVER prefix with VITE_, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 S3-Compatible API Credentials
# NOTE: All R2 credentials are strictly SERVER-ONLY.
# NEVER use VITE_ prefixes for R2 credentials to prevent them from being bundled into client assets.
# Find or generate these in Cloudflare Dashboard: R2 -> Manage R2 API Tokens (Object Read & Write on test bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Dedicated Test Bucket for Isolated Integration Testing
# Safety rule: R2_INTEGRATION_TEST strictly requires R2_BUCKET_NAME === R2_TEST_BUCKET_NAME
# and will refuse to run against any production bucket.
R2_TEST_BUCKET_NAME=

# R2 Integration Test Opt-In (Set to 1 only when running isolated live tests against a dedicated test bucket)
R2_INTEGRATION_TEST=0

# Vercel Cron: secret sent by Vercel to /api/upload/purge (server-only)
CRON_SECRET=

# ------------------------------------------------------------------------------
# Ballech - WhatsApp agent (server-only, NEVER prefix with VITE_)
# ------------------------------------------------------------------------------
# Meta WhatsApp Cloud API (developers.facebook.com -> your app -> WhatsApp -> API Setup)
# Free string you choose, pasted in Meta's webhook settings ("Verify token")
WHATSAPP_VERIFY_TOKEN=
# App secret (App settings -> Basic): used to verify X-Hub-Signature-256
WHATSAPP_APP_SECRET=
# Permanent system-user access token with whatsapp_business_messaging
WHATSAPP_ACCESS_TOKEN=
# Phone number ID (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# Optional, Graph API version (default v23.0)
WHATSAPP_GRAPH_VERSION=

# LLM provider: gemini (default, free tier while testing) or anthropic
BALLECH_PROVIDER=gemini
# Optional model override. Defaults: gemini-flash-latest / claude-haiku-5-5
BALLECH_MODEL=
# Google AI Studio key (required when BALLECH_PROVIDER=gemini)
GEMINI_API_KEY=
# Optional, only when BALLECH_PROVIDER=anthropic
ANTHROPIC_API_KEY=
